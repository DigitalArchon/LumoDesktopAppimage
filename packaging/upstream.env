# The Lumo Desktop source this repository packages: Proton's repository, the commit, and the
# version that commit's src-tauri/tauri.conf.json says it is (the build checks they agree).
# RELEASE counts this repository's own releases of that version: v<VERSION>-<RELEASE>.
# upstream-watch.yml rewrites this file when Proton publishes a new version.
UPSTREAM_REPO=https://github.com/ProtonLumo/lumo-desktop
UPSTREAM_COMMIT=bd5e2c608bac61f215d4a2094e26ef88cb7bc1e0
UPSTREAM_VERSION=0.5.9
RELEASE=1
